# 🎮 Advanced Gaming Platform - Environment Configuration

# =============================================================================
# 🚀 APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=7777
CLIENT_URL=http://localhost:3000

# Application Info
APP_NAME="Advanced Gaming Platform"
APP_VERSION="2.0.0"
SUPPORT_EMAIL="support@gaming-platform.com"

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
# MongoDB
MONGODB_URI=mongodb://localhost:27017/gaming_platform
MONGODB_TEST_URI=mongodb://localhost:27017/gaming_platform_test

# Redis (for caching, sessions, real-time features)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=""

# =============================================================================
# 🔐 SECURITY & AUTHENTICATION
# =============================================================================
# JWT Secrets (IMPORTANT: Use strong, unique secrets in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key
SESSION_SECRET=your-session-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# 💳 PAYMENT GATEWAYS
# =============================================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (for Indian market)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # or live

# =============================================================================
# ₿ CRYPTOCURRENCY SUPPORT
# =============================================================================
# Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
ETH_DEPOSIT_ADDRESS=0xYourEthereumDepositAddress
ETH_PRIVATE_KEY=your_private_key_for_withdrawals

# Bitcoin (if implementing)
BTC_RPC_URL=https://your-bitcoin-node
BTC_DEPOSIT_ADDRESS=your_bitcoin_deposit_address

# =============================================================================
# 📧 EMAIL SERVICES
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid (alternative)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Email Addresses
FROM_EMAIL=noreply@gaming-platform.com
ADMIN_EMAIL=admin@gaming-platform.com

# =============================================================================
# 📱 SMS & MESSAGING
# =============================================================================
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# 🔔 PUSH NOTIFICATIONS
# =============================================================================
# Web Push (VAPID keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Firebase (for mobile push)
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# =============================================================================
# 🎯 THIRD-PARTY INTEGRATIONS
# =============================================================================
# Google Analytics
GA_TRACKING_ID=UA-000000000-0

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Social Auth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# =============================================================================
# 🎮 GAME CONFIGURATION
# =============================================================================
# Game Settings
DEFAULT_MIN_BET=1
DEFAULT_MAX_BET=1000
HOUSE_EDGE=0.025
MAX_PLAYERS_PER_GAME=10

# Provably Fair
GAME_SEED_SECRET=your-game-seed-secret-for-fairness

# =============================================================================
# 💰 FINANCIAL SETTINGS
# =============================================================================
# Withdrawal Limits
DAILY_WITHDRAWAL_LIMIT=1000
WEEKLY_WITHDRAWAL_LIMIT=5000
MONTHLY_WITHDRAWAL_LIMIT=20000

# Fees
WITHDRAWAL_FEE_PERCENTAGE=0.02
MINIMUM_WITHDRAWAL_FEE=1
MAXIMUM_WITHDRAWAL_FEE=25

# Currency Settings
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,INR,BTC,ETH

# =============================================================================
# 📊 MONITORING & ANALYTICS
# =============================================================================
# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn

# Application Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# =============================================================================
# ☁️ CLOUD SERVICES
# =============================================================================
# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Cloudinary (image/video processing)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# 🔧 DEVELOPMENT & TESTING
# =============================================================================
# Development
DEBUG=gaming-platform:*
MOCK_PAYMENTS=true # Set to false in production
ENABLE_CORS=true

# Testing
TEST_DATABASE_URL=mongodb://localhost:27017/gaming_platform_test
TEST_PORT=8888

# =============================================================================
# 🌐 PRODUCTION SETTINGS
# =============================================================================
# SSL
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Domain
DOMAIN=gaming-platform.com
SUBDOMAIN=api

# CDN
CDN_URL=https://cdn.gaming-platform.com

# =============================================================================
# 🐳 DOCKER CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=gaming-platform
DOCKER_REGISTRY=registry.gaming-platform.com

# =============================================================================
# 📈 ADVANCED FEATURES
# =============================================================================
# Real-time Features
ENABLE_WEBSOCKETS=true
WEBSOCKET_ORIGINS=http://localhost:3000,https://gaming-platform.com

# AI & Machine Learning
ML_MODEL_ENDPOINT=https://api.gaming-platform.com/ml
ENABLE_AI_MODERATION=true

# Blockchain Integration
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-project-id
SMART_CONTRACT_ADDRESS=0xYourSmartContractAddress

# Geographic Restrictions
RESTRICTED_COUNTRIES=US,FR,UK # Countries where gambling is restricted
ENABLE_GEO_BLOCKING=true

# KYC/AML
KYC_PROVIDER=jumio
KYC_API_KEY=your_kyc_api_key
KYC_THRESHOLD=1000 # Amount threshold for KYC verification

# =============================================================================
# 🛡️ SECURITY FEATURES
# =============================================================================
# Two-Factor Authentication
ENABLE_2FA=true
TOTP_ISSUER=Gaming Platform

# IP Whitelisting (for admin functions)
ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24

# DDoS Protection
ENABLE_DDOS_PROTECTION=true
DDOS_BURST_SIZE=20
DDOS_REPLENISH_RATE=5

# Content Security Policy
CSP_REPORT_URI=https://gaming-platform.report-uri.com/r/d/csp/enforce

# =============================================================================
# 📱 MOBILE APP CONFIGURATION
# =============================================================================
# Mobile API
MOBILE_API_VERSION=v1
MOBILE_MIN_VERSION=1.0.0

# App Store
IOS_APP_ID=123456789
ANDROID_PACKAGE_NAME=com.gaming.platform

# =============================================================================
# 🎨 UI/UX CUSTOMIZATION
# =============================================================================
# Theming
DEFAULT_THEME=dark
ENABLE_THEME_SWITCHING=true

# Branding
BRAND_PRIMARY_COLOR=#667eea
BRAND_SECONDARY_COLOR=#764ba2
BRAND_ACCENT_COLOR=#f093fb

# =============================================================================
# 🔄 BACKUP & RECOVERY
# =============================================================================
# Database Backup
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups/

# File Backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_PROVIDER=aws-s3

# =============================================================================
# 📊 BUSINESS INTELLIGENCE
# =============================================================================
# Analytics
ENABLE_ADVANCED_ANALYTICS=true
ANALYTICS_RETENTION_PERIOD=365

# Reporting
DAILY_REPORT_EMAIL=reports@gaming-platform.com
ENABLE_AUTOMATED_REPORTS=true

# =============================================================================
# 🚨 IMPORTANT NOTES
# =============================================================================
# 1. Change all default secrets and keys before deploying to production
# 2. Use environment-specific .env files (.env.production, .env.staging)
# 3. Never commit .env files to version control
# 4. Use a secret management service in production (AWS Secrets Manager, etc.)
# 5. Regularly rotate API keys and secrets
# 6. Monitor for any exposed credentials in logs or error messages