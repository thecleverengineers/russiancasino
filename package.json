{
  "name": "advanced-gaming-platform",
  "version": "2.0.0",
  "description": "Advanced Gaming and Payment Platform with Modern Tech Stack",
  "main": "server.js",
  "type": "module",
  "author": "Advanced Gaming Platform Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "start": "node server.js",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "server:dev": "nodemon --experimental-modules server.js",
    "server:start": "node server.js",
    "build": "npm run client:build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t gaming-platform .",
    "docker:run": "docker run -p 3000:3000 -p 7777:7777 gaming-platform",
    "analyze": "npm run build && npx vite-bundle-analyzer"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
